---
import '../styles/global.css'
import Header from '../components/layout/Header.vue'
import Footer from '../components/layout/Footer.vue'

interface Props {
  title?:       string
  description?: string
  ogImage?:     string
  noIndex?:     boolean
  canonical?:   string
  structuredData?: Record<string, unknown> | Record<string, unknown>[]
}

const {
  title       = 'Двери ВФД на Кашириных — Салон дверей в Челябинске',
  description = 'Фирменный салон дверей и алюминиевых перегородок на Братьев Кашириных 131Б. Работаем с 2014 года.',
  ogImage     = 'https://storage.yandexcloud.net/catalog-vfd/renders/hero-cover.webp',
  noIndex     = false,
  canonical,
  structuredData,
} = Astro.props

const canonicalUrl = canonical
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : null
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:type"        content="website" />
    <meta property="og:locale"      content="ru_RU" />
    <meta name="theme-color"        content="#f8f9fa" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <title>{title}</title>

    <link
      rel="preload" as="image"
      href="https://storage.yandexcloud.net/catalog-vfd/renders/hero-cover.webp"
      fetchpriority="high"
    />
    {structuredDataJson && (
      <script type="application/ld+json" is:inline set:html={structuredDataJson} />
    )}
  </head>

  <body class="min-h-screen flex flex-col">

    <!-- Header: только клиент, без hydration mismatch -->
    <Header client:only="vue" />

    <main
      id="main-content"
      class="flex-1 relative overflow-x-hidden"
      style="padding-top: var(--header-height, 88px)"
    >
      <slot />
    </main>

    <!-- Footer: модальное окно требует Vue -->
    <Footer client:only="vue" />

    <!-- Баннер согласия с обработкой данных (ФЗ-152) -->
    <div id="cookie-banner" style="display:none;position:fixed;bottom:1.25rem;left:50%;transform:translateX(-50%);z-index:9999;width:calc(100% - 2rem);max-width:720px;">
      <div style="background:#0f172a;border:1px solid rgba(255,255,255,0.08);border-radius:1.25rem;padding:1.125rem 1.375rem;display:flex;align-items:center;gap:1.25rem;box-shadow:0 8px 32px rgba(0,0,0,0.32),0 2px 8px rgba(0,0,0,0.2);flex-wrap:wrap;">
        <!-- иконка -->
        <div style="flex-shrink:0;width:2.25rem;height:2.25rem;background:rgba(13,148,136,0.18);border-radius:0.625rem;display:flex;align-items:center;justify-content:center;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" fill="#2dd4bf"/>
          </svg>
        </div>
        <!-- текст -->
        <p style="margin:0;color:#94a3b8;font-size:0.8125rem;line-height:1.55;flex:1;min-width:180px;">
          Сайт использует файлы cookie и обрабатывает технические данные для корректной работы.
          <a href="/privacy" style="color:#2dd4bf;text-decoration:none;font-weight:500;white-space:nowrap;">Политика конфиденциальности</a>
        </p>
        <!-- кнопки -->
        <div style="display:flex;gap:0.625rem;flex-shrink:0;">
          <button id="cookie-accept" style="padding:0.5rem 1.25rem;background:linear-gradient(135deg,#0d9488,#14b8a6);color:#fff;border:none;border-radius:9999px;font-size:0.8125rem;font-weight:600;cursor:pointer;white-space:nowrap;transition:opacity .15s;">
            Принять
          </button>
          <a href="/privacy" style="padding:0.5rem 1.125rem;background:transparent;color:#64748b;border:1px solid rgba(255,255,255,0.1);border-radius:9999px;font-size:0.8125rem;font-weight:500;cursor:pointer;white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;">
            Подробнее
          </a>
        </div>
      </div>
    </div>

    <script is:inline>
      (function() {
        var banner = document.getElementById('cookie-banner');
        if (!localStorage.getItem('cookie-consent') && banner) {
          banner.style.display = 'block';
        }
        var btn = document.getElementById('cookie-accept');
        if (btn) {
          btn.addEventListener('click', function() {
            localStorage.setItem('cookie-consent', '1');
            var banner = document.getElementById('cookie-banner');
            if (banner) {
              banner.style.transition = 'opacity .25s, transform .25s';
              banner.style.opacity = '0';
              banner.style.transform = 'translateX(-50%) translateY(1rem)';
              setTimeout(function() { banner.style.display = 'none'; }, 260);
            }
          });
          btn.addEventListener('mouseenter', function() { btn.style.opacity = '0.88'; });
          btn.addEventListener('mouseleave', function() { btn.style.opacity = '1'; });
        }
      })();
    </script>

  </body>
</html>
