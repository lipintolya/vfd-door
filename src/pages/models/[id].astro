---
import { supabase } from '../../lib/supabase'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import ProductColorPicker from '../../components/catalog/ProductColorPicker.vue'
import type { ColorVariant } from '../../components/catalog/ProductColorPicker.vue'
import { getSeriesSpec } from '../../data/series-descriptions'
import { accessoriesByCoating, CATEGORY_LABELS } from '../../data/accessories'
import type { AccessoryCategory } from '../../data/accessories'

export async function getStaticPaths() {
  const { data, error } = await supabase
    .from('model_colors')
    .select(`
      price_rrp,
      photo_url,
      model_id,
      color_id,
      colors ( id, name, hex_preview, coatings ( id, name, slug ) ),
      models ( id, name, has_glass, series ( id, name, slug, coatings ( id, name, slug ) ) )
    `)
    .order('price_rrp', { ascending: true })

  if (error || !data) {
    console.error('getStaticPaths error:', error?.message)
    return []
  }

  const normalizeHex = (v: string | null | undefined) => {
    const s = (v ?? '').trim().replaceAll('С', 'C').replaceAll('с', 'c')
    return /^#[0-9a-fA-F]{3,6}$/.test(s) ? s : '#cccccc'
  }

  type ModelEntry = {
    model:       { id: string; name: string; hasGlass: boolean }
    seriesName:  string
    seriesSlug:  string
    coatingName: string
    coatingSlug: string
    colors:      ColorVariant[]
    minPrice:    number | null
  }

  const modelMap = new Map<string, ModelEntry>()

  for (const row of data) {
    const model  = row.models  as any
    const color  = row.colors  as any
    if (!model || !color) continue

    const series        = model.series   as any
    const seriesCoating = series?.coatings as any
    const colorCoating  = color.coatings  as any
    const coating       = seriesCoating ?? colorCoating

    if (!modelMap.has(model.id)) {
      modelMap.set(model.id, {
        model: {
          id:       model.id,
          name:     model.name,
          hasGlass: model.has_glass ?? false,
        },
        seriesName:  series?.name     ?? '',
        seriesSlug:  series?.slug     ?? '',
        coatingName: coating?.name    ?? '',
        coatingSlug: coating?.slug    ?? '',
        colors:      [],
        minPrice:    null,
      })
    }

    const entry = modelMap.get(model.id)!

    if (!entry.colors.some(c => c.id === color.id)) {
      entry.colors.push({
        id:          color.id,
        name:        color.name,
        hex:         normalizeHex(color.hex_preview),
        photo:       row.photo_url  ?? '',
        price:       row.price_rrp  ?? null,
        coatingSlug: coating?.slug  ?? '',
      })
    }

    if (row.price_rrp && (!entry.minPrice || row.price_rrp < entry.minPrice)) {
      entry.minPrice = row.price_rrp
    }
  }

  return [...modelMap.values()].map(entry => ({
    params: { id: entry.model.id },
    props:  entry,
  }))
}

const { model, colors, minPrice, seriesName, seriesSlug, coatingName, coatingSlug } = Astro.props

const spec        = getSeriesSpec(seriesSlug, coatingSlug)
const accessories = accessoriesByCoating[coatingSlug] ?? []

const accessoryGroups: [string, typeof accessories][] = Object.entries(
  accessories.reduce<Record<string, typeof accessories>>((acc, item) => {
    ;(acc[item.category] ??= []).push(item)
    return acc
  }, {})
)

const canonicalUrl  = Astro.site ? new URL(`/models/${model.id}`, Astro.site).href : undefined
const priceStr      = minPrice ? `от ${minPrice.toLocaleString('ru-RU')} ₽` : ''
const seriesPart    = seriesName ? `серия ${seriesName}` : ''
const coatingPart   = coatingName

const pageTitle     = [model.name, seriesPart, coatingPart].filter(Boolean).join(' — ') + ' | ВФД Челябинск'
const pageDesc      = spec.description ||
  `Дверь ${model.name}${seriesName ? ` серии ${seriesName}` : ''}${coatingName ? `, ${coatingName}` : ''}${priceStr ? `. Цена ${priceStr}` : ''}. Купить в салоне ВФД в Челябинске.`

const breadcrumbs = [
  { label: 'Главная',  href: '/' },
  { label: 'Каталог',  href: '/catalog' },
  ...(seriesName ? [{ label: seriesName, href: `/catalog?series=${seriesSlug}` }] : []),
  { label: model.name },
]

const structuredData = {
  '@context': 'https://schema.org',
  '@type':    'Product',
  name:        model.name,
  description: pageDesc,
  url:         canonicalUrl,
  brand:       { '@type': 'Brand', name: 'ВФД' },
  offers: {
    '@type':        'Offer',
    priceCurrency:  'RUB',
    availability:   'https://schema.org/InStoreOnly',
    seller:         { '@type': 'Organization', name: 'Салон дверей ВФД' },
    ...(minPrice
      ? {
          price:            minPrice,
          priceValidUntil:  new Date(Date.now() + 90 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
        }
      : {}),
  },
}
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical={canonicalUrl}
  ogImage={colors[0]?.photo || undefined}
  structuredData={structuredData}
>
  <div class="section product-page">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <div class="product-layout">

        <!-- ── Фото + выбор цвета (Vue island) ── -->
        <ProductColorPicker
          client:load
          colors={colors}
          modelName={model.name}
        />

        <!-- ── Характеристики (статический HTML для SEO) ── -->
        <div class="product-info">
          <div class="product-badges">
            {seriesName && <span class="product-badge">{seriesName}</span>}
            {coatingName && <span class="product-badge product-badge--muted">{coatingName}</span>}
          </div>

          <h1 class="product-title">{model.name}</h1>

          {spec.description && (
            <p class="product-description">{spec.description}</p>
          )}

          {(spec.features.length > 0 || spec.coating || spec.material || spec.edge || spec.thickness) && (
            <dl class="product-specs">
              {spec.features.length > 0 && (
                <div class="product-specs__row">
                  <dt>Особенности</dt>
                  <dd>{spec.features.join('; ')}</dd>
                </div>
              )}
              {spec.coating && (
                <div class="product-specs__row">
                  <dt>Покрытие / Отделка</dt>
                  <dd>{spec.coating}</dd>
                </div>
              )}
              {spec.material && (
                <div class="product-specs__row">
                  <dt>Материал / Конструктив</dt>
                  <dd>{spec.material}</dd>
                </div>
              )}
              {spec.edge && (
                <div class="product-specs__row">
                  <dt>Кромка</dt>
                  <dd>{spec.edge}</dd>
                </div>
              )}
              {spec.thickness && (
                <div class="product-specs__row">
                  <dt>Толщина</dt>
                  <dd>{spec.thickness} мм</dd>
                </div>
              )}
            </dl>
          )}

          <!-- Быстрый ориентир по цене (статика, всегда виден до гидратации) -->
          {minPrice && (
            <p class="product-price-hint">
              Цена: <strong>от {minPrice.toLocaleString('ru-RU')} ₽</strong> за полотно
            </p>
          )}

          <div class="product-contact">
            <p class="product-contact__note">
              Уточните наличие нужного цвета и размера у менеджера салона
            </p>
            <div class="product-contact__cta">
              <a href="tel:+79000297888" class="btn btn-primary">
                +7 (900) 029-78-88
              </a>
              <a href="/contacts" class="btn btn-outline">Контакты</a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ── Погонажные изделия ── -->
  {accessories.length > 0 && (
    <section class="accessories-section">
      <div class="container">
        <div class="accessories-header">
          <h2 class="accessories-title">Погонажные изделия</h2>
          <p class="accessories-note">
            Цены уточняйте у менеджера в салоне или по телефону
          </p>
        </div>
        <div class="accessories-groups">
          {accessoryGroups.map(([category, items]) => (
            <div class="accessories-group">
              <p class="accessories-group__label">
                {CATEGORY_LABELS[category as AccessoryCategory] ?? category}
              </p>
              <ul class="accessories-list">
                {items.map(item => (
                  <li class="accessories-item">{item.name}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
/* ── Product layout ── */
.product-page {
  padding-bottom: clamp(3rem, 5vw, 5rem);
}

.product-layout {
  display: grid;
  grid-template-columns: 480px 1fr;
  gap: 3.5rem;
  margin-top: 1.75rem;
  align-items: start;
}

@media (max-width: 900px) {
  .product-layout {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}

/* ── Info panel ── */
.product-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.product-badge {
  display: inline-flex;
  align-items: center;
  padding: 0.3rem 0.875rem;
  border-radius: 9999px;
  background: #f0fdfa;
  border: 1px solid #ccfbf1;
  color: #0f766e;
  font-size: 0.8rem;
  font-weight: 700;
}

.product-badge--muted {
  background: #f8fafc;
  border-color: #e2e8f0;
  color: #475569;
}

.product-title {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 900;
  line-height: 1.08;
  letter-spacing: -0.03em;
  color: #0f172a;
  margin: 0 0 1rem;
}

.product-description {
  font-size: 1rem;
  color: #475569;
  line-height: 1.65;
  margin: 0 0 1.5rem;
}

/* ── Specs table ── */
.product-specs {
  margin: 0 0 1.75rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.product-specs__row {
  display: grid;
  grid-template-columns: 160px 1fr;
}

.product-specs__row + .product-specs__row {
  border-top: 1px solid var(--color-border);
}

.product-specs__row dt {
  padding: 0.75rem 1rem;
  font-size: 0.8125rem;
  font-weight: 600;
  color: #64748b;
  background: #f8fafc;
}

.product-specs__row dd {
  padding: 0.75rem 1rem;
  font-size: 0.875rem;
  color: #0f172a;
  margin: 0;
  line-height: 1.55;
}

@media (max-width: 480px) {
  .product-specs__row {
    grid-template-columns: 1fr;
  }
  .product-specs__row dt {
    padding-bottom: 0.25rem;
  }
}

/* ── Price hint + contacts ── */
.product-price-hint {
  font-size: 0.9375rem;
  color: #475569;
  margin: 0 0 1.25rem;
}

.product-price-hint strong {
  color: #0f172a;
  font-weight: 700;
}

.product-contact {
  background: #f8fafc;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 1.25rem 1.5rem;
}

.product-contact__note {
  font-size: 0.875rem;
  color: #64748b;
  margin: 0 0 1rem;
  line-height: 1.5;
}

.product-contact__cta {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

/* ── Accessories ── */
.accessories-section {
  background: #0f172a;
  padding: clamp(2.5rem, 4vw, 4rem) 0;
}

.accessories-header {
  margin-bottom: 2rem;
}

.accessories-title {
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 800;
  color: #fff;
  margin: 0 0 0.375rem;
}

.accessories-note {
  font-size: 0.9rem;
  color: #64748b;
  margin: 0;
}

.accessories-groups {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 1.25rem;
}

.accessories-group {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 1rem;
  padding: 1.125rem 1.25rem;
}

.accessories-group__label {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #14b8a6;
  margin: 0 0 0.75rem;
}

.accessories-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.accessories-item {
  font-size: 0.875rem;
  color: #cbd5e1;
  line-height: 1.45;
  padding: 0.4rem 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.accessories-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
</style>
