<script is:inline>
  (function () {
    var videos = document.querySelectorAll('.pt-autoplay-video')
    if (!videos.length || !('IntersectionObserver' in window)) return

    // Плавное появление видео — только когда реально начало играть
    videos.forEach(function (v) {
      v.addEventListener('playing', function () {
        v.classList.add('pt-video-ready')
      })
    })

    // Кнопка повтора: показывается после окончания, скрывается при клике
    videos.forEach(function (v) {
      var btn = v.parentElement && v.parentElement.querySelector('.pt-pivot-replay')
      if (!btn) return
      v.addEventListener('ended', function () {
        btn.classList.add('is-visible')
      })
      btn.addEventListener('click', function () {
        btn.classList.remove('is-visible')
        v.currentTime = 0
        v.play().catch(function () {})
      })
    })

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        var v = entry.target
        if (entry.isIntersecting) {
          // Lazy-load src при первом появлении в viewport
          var source = v.querySelector('source[data-src]')
          if (source && !source.getAttribute('src')) {
            source.setAttribute('src', source.getAttribute('data-src'))
            v.load()
          }
          // Не запускаем если уже закончился (ждём клика на replay)
          if (!v.ended) v.play().catch(function () {})
        } else {
          if (!v.ended) v.pause()
        }
      })
    }, { threshold: 0.4 })

    videos.forEach(function (v) { io.observe(v) })
  })()

  // ── Лайтбокс: открыть через custom event ──
  function openLightbox(images, index) {
    window.dispatchEvent(new CustomEvent('open-lightbox', { detail: { images: images, index: index } }))
  }

  // ── Слайдеры (общая функция) ──
  function initSlider(container, withLightbox) {
    if (!container) return
    var slides  = container.querySelector('.pt-stat-slides')
    var dots    = container.querySelectorAll('.pt-stat-dot')
    var counter = container.querySelector('.pt-hotel-cur')
    var prev    = container.querySelector('.pt-stat-prev, .pt-hotel-prev')
    var next    = container.querySelector('.pt-stat-next, .pt-hotel-next')
    var total   = counter
      ? container.querySelectorAll('.pt-stat-slide').length
      : dots.length
    var cur     = 0

    function goTo(idx) {
      cur = (idx + total) % total
      slides.style.transform = 'translateX(' + (-cur * 100) + '%)'
      if (dots.length) dots.forEach(function (d, i) { d.classList.toggle('is-active', i === cur) })
      if (counter) counter.textContent = cur + 1
    }

    if (prev) prev.addEventListener('click', function (e) { e.stopPropagation(); goTo(cur - 1) })
    if (next) next.addEventListener('click', function (e) { e.stopPropagation(); goTo(cur + 1) })
    dots.forEach(function (d, i) {
      d.addEventListener('click', function (e) { e.stopPropagation(); goTo(i) })
    })

    var startX = 0
    container.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX }, { passive: true })
    container.addEventListener('touchend',   function (e) {
      var dx = e.changedTouches[0].clientX - startX
      if (Math.abs(dx) > 40) goTo(dx < 0 ? cur + 1 : cur - 1)
    }, { passive: true })

    if (withLightbox) {
      var slideImgs = container.querySelectorAll('.pt-stat-slide')
      container.addEventListener('click', function (e) {
        if (e.target.closest('.pt-stat-dot, .pt-stat-prev, .pt-stat-next, .pt-hotel-prev, .pt-hotel-next')) return
        var imgs = Array.from(slideImgs).map(function (img) {
          return { src: img.src, alt: img.alt }
        })
        openLightbox(imgs, cur)
      })
    }
  }

  initSlider(document.querySelector('.pt-stat-slider:not(.pt-hotel-slider)'))
  initSlider(document.querySelector('.pt-hotel-slider'))
  document.querySelectorAll('.pt-track-slider').forEach(function (s) { initSlider(s, true) })

  // ── Лайтбокс для одиночных фото (крепления) ──
  document.querySelectorAll('[data-lb-src]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      openLightbox([{ src: btn.dataset.lbSrc, alt: btn.dataset.lbAlt }], 0)
    })
  })
</script>

  <PhotoLightbox client:only="vue" />
