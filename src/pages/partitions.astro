---
import BaseLayout from '../layouts/BaseLayout.astro'
import PartitionsPage from '../components/partitions/PartitionsPage.vue'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'

const title = 'Алюминиевые перегородки и системы — ВФД в Челябинске'
const description = 'Алюминиевые перегородки, раздвижные системы и стеклянные конструкции от Владимирской фабрики дверей. Замер и проект бесплатно. Монтаж в Челябинске.'

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Перегородки' },
]
---

<BaseLayout title={title} description={description}>
  <div class="container" style="padding-top: clamp(1.5rem, 3vw, 2rem)">
    <Breadcrumbs items={breadcrumbItems} />
  </div>
  <PartitionsPage client:load />
</BaseLayout>
