---
/**
 * src/pages/index.astro — Главная страница
 * Header больше не нужен здесь — он подключён в BaseLayout.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroSlider from '../components/home/HeroSlider.vue'
import Features from '../components/home/Features.vue'
import CatalogCategories from '../components/home/CatalogCategories.vue'
import Promo from '../components/home/Promo.vue'
import Faq from '../components/home/Faq.vue'
import { faqs } from '../components/home/faq-data'

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
}

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Салон дверей ВФД на Кашириных',
  description: 'Фирменный салон входных и межкомнатных дверей, алюминиевых перегородок в Челябинске. Работаем с 2014 года.',
  url: 'https://vfd74.ru',
  telephone: ['+79000297888', '+79630807888'],
  email: 'vfddoors74@mail.ru',
  image: 'https://storage.yandexcloud.net/catalog-vfd/renders/hero-cover.webp',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ул. Братьев Кашириных, 131Б',
    addressLocality: 'Челябинск',
    addressRegion: 'Челябинская область',
    postalCode: '454128',
    addressCountry: 'RU',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 55.172868,
    longitude: 61.306572,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '10:00',
      closes: '20:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '11:00',
      closes: '16:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Sunday',
      opens: 'Closed',
      closes: 'Closed',
    },
  ],
  foundingDate: '2014',
  priceRange: '₽₽',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '4',
    bestRating: '5',
  },
  sameAs: [
    'https://vk.com/vfddoors74',
    'https://t.me/vfddoors74',
    'https://max.ru/id452402308842_biz',
    'https://2gis.ru/chelyabinsk/firm/70000001093506304',
    'https://yandex.ru/maps/-/CPwenX08',
  ],
}
---

<BaseLayout
  title="Межкомнатные и входные двери в Челябинске — ВФД"
  description="Официальный салон ВФД в Челябинске — 80+ моделей в наличии, бесплатный замер, монтаж под ключ. Межкомнатные, входные двери и алюминиевые перегородки на Кашириных, 131Б."
  structuredData={[faqSchema, localBusinessSchema]}
  preloadHero={true}
>
  <HeroSlider client:load />
  <Features client:visible />
  <CatalogCategories client:visible />
  <Promo client:idle />
  <Faq client:idle />
</BaseLayout>