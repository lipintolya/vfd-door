---
/**
 * src/pages/catalog.astro
 * Данные грузятся на сервере — полный JOIN через Supabase (src/lib/catalog-data.ts).
 * Фильтрация — клиентская (Vue island), без перезагрузки страницы.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import CatalogClient from '../components/catalog/CatalogClient.vue'
import { getCatalogCards, getSeriesCardsData } from '../lib/catalog-data'

const { cards, error } = await getCatalogCards()
const seriesCardsData = getSeriesCardsData(cards)

/* ── Превью серий сверху каталога — группировка по покрытию, как в
   фильтре ниже: Эмалекс / Эмаль / Протач / ПЭТ. Порядок фиксирован для
   известных покрытий, всё остальное — следом по алфавиту, чтобы новая
   группа (напр. будущее покрытие) не потерялась молча. ── */
const COATING_ORDER = ['emalex', 'emal', 'protach', 'pet']

const seriesCoatingGroups = [...new Map(
  seriesCardsData.map(s => [s.coatingSlug, { slug: s.coatingSlug, name: s.coatingName }])
).values()]
  .sort((a, b) => {
    const ai = COATING_ORDER.indexOf(a.slug)
    const bi = COATING_ORDER.indexOf(b.slug)
    if (ai === -1 && bi === -1) return a.name.localeCompare(b.name, 'ru')
    if (ai === -1) return 1
    if (bi === -1) return -1
    return ai - bi
  })
  .map(coating => ({
    ...coating,
    series: seriesCardsData.filter(s => s.coatingSlug === coating.slug),
  }))

/* ── Уникальные опции для фильтров ── */
const allSeries = [...new Map(
  cards
    .filter(c => c.seriesSlug)
    .map(c => [c.seriesSlug, { label: c.series, value: c.seriesSlug }])
).values()]

const allCoatings = [...new Map(
  cards
    .filter(c => c.coatingSlug)
    .map(c => [c.coatingSlug, { label: c.coating, value: c.coatingSlug }])
).values()]

/* Из colorSwatches (полный набор цветов на модель, не только первого) —
   свотчи уже содержат все цвета каждой модели, так что колонка не теряет
   цвета, которые ни у одной модели не оказались «первыми». */
const allColors = [...new Map(
  cards
    .flatMap(c => c.colorSwatches.map(s => [s.name, { label: s.name, value: s.name, color: s.hex }] as const))
).values()]

/* ── Начальные фильтры из URL ── */
const urlSeries  = Astro.url.searchParams.get('series')  ?? ''
const urlCoating = Astro.url.searchParams.get('coating') ?? ''
const urlColor   = Astro.url.searchParams.get('color')   ?? ''

const canonicalUrl = Astro.site ? new URL('/catalog', Astro.site).href : undefined
const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Каталог' },
]

const structuredData = canonicalUrl ? [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: item.href ? new URL(item.href, canonicalUrl).href : canonicalUrl,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Каталог дверей ВФД на Кашириных',
    description: 'Каталог межкомнатных и входных дверей с ценами, сериями, покрытиями и цветами.',
    url: canonicalUrl,
    numberOfItems: cards.length,
  },
] : undefined
---

<BaseLayout
  title="Каталог дверей — ВФД на Кашириных"
  description="Каталог межкомнатных и входных дверей с ценами. Серии Иннова, Линеа и другие. Салон ВФД в Челябинске."
  canonical={canonicalUrl}
  structuredData={structuredData}
>
  {error && (
    <div class="container pt-8">
      <div class="rounded-2xl bg-red-50 border border-red-100 px-5 py-4 text-red-700 text-sm">
        Ошибка загрузки каталога: {error}
      </div>
    </div>
  )}

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  {seriesCoatingGroups.length > 0 && (
    <div id="series" class="section bg-white" style="padding-bottom: 0; scroll-margin-top: 5.5rem">
      <div class="container">
        {seriesCoatingGroups.map(group => (
          <div class="mb-8 last:mb-0">
            <div class="mb-4 flex items-baseline gap-3">
              <h2 class="m-0 text-lg font-medium text-ink">{group.name}</h2>
              <span class="text-xs font-semibold text-slate-400">{group.series.length} {group.series.length === 1 ? 'серия' : 'серий'}</span>
            </div>
            <div class="-mx-1 flex snap-x snap-mandatory gap-3 overflow-x-auto px-1 pb-2">
              {group.series.map(s => (
                <a href={`/catalog/series/${s.slug}`} class="group flex w-28 shrink-0 snap-start flex-col gap-2 sm:w-32">
                  <div class="aspect-4/3 overflow-hidden rounded-xl border border-slate-200 bg-slate-100">
                    {s.cover && (
                      <img
                        src={s.cover}
                        alt={`Серия ${s.name} — ВФД`}
                        loading="lazy"
                        decoding="async"
                        width="200"
                        height="150"
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                      />
                    )}
                  </div>
                  <span class="truncate text-center text-xs font-semibold text-slate-700">{s.name}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <div class="section bg-white">
    <div class="container">
      <CatalogClient
        client:load
        cards={cards}
        series={allSeries}
        coatings={allCoatings}
        colors={allColors}
        initialSeries={urlSeries}
        initialCoating={urlCoating}
        initialColor={urlColor}
      />
    </div>
  </div>
</BaseLayout>
