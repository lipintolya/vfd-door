---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import CoverSwitcher      from '../../components/catalog/CoverSwitcher.vue'
import ColorSelector      from '../../components/catalog/ColorSelector.vue'
import InfoImageViewer    from '../../components/catalog/InfoImageViewer.vue'
import WorksGallery      from '../../components/catalog/WorksGallery.vue'
import { INVISIBLE_WORKS } from '../../data/skrytye-dveri-works'
import {
  IMAGES,
  INFO_IMAGES,
  SECRET_SIZES,
  SECRET_REVERS_SIZES,
  DOOR_HEIGHT,
  POLOTNO_PRICE_SECRET,
  POLOTNO_PRICE_SECRET_REVERS,
  TOTAL_SECRET,
  TOTAL_SECRET_REVERS,
  CUSTOM_HEIGHT_TIERS,
  CUSTOM_LEAD_TIME,
  calcCustomPrice,
} from '../../data/skrytye-dveri-products'

const PHONE = '+79000297888'
const TG    = 'https://t.me/vfddoors74'

const WORKS_LIMIT = 4
const ARCHIVE_HREF = '/catalog/skrytye-dveri/raboty'
const featuredWorks = INVISIBLE_WORKS.slice(0, WORKS_LIMIT)

const fmt = (n: number) => n.toLocaleString('ru-RU') + ' ₽'

const canonicalUrl = Astro.site
  ? new URL('/catalog/skrytye-dveri', Astro.site).href
  : undefined

const breadcrumbItems = [
  { label: 'Главная', href: '/' },
  { label: 'Каталог', href: '/catalog' },
  { label: 'Скрытые двери' },
]

const faq = [
  { q: 'Чем скрытая дверь отличается от обычной?',
    a: 'Нет видимых наличников и коробки — алюминиевая рама монтируется заподлицо, полотно располагается вровень со стеной. Петли скрытые. Дверь визуально растворяется в интерьере.' },
  { q: 'Что входит в комплект?',
    a: 'Полотно серии «Секрет» или «Секрет Реверс» и комплект скрытого короба: профиль 54×43 мм (2,5 пог. м), запил под ответную планку, ответная планка и две скрытые петли. Ручка, стопор, завёртка WC — опционально.' },
  { q: 'Можно покрасить в цвет стены?',
    a: 'Да. Полотно поставляется в грунте — красится или штукатурится после монтажа. Главное: красить только после установки, чтобы зазоры совпали по цвету.' },
  { q: 'В чём разница «Секрет» и «Секрет Реверс»?',
    a: '«Секрет» открывается «на себя» (прямой монтаж). «Секрет Реверс» — «от себя», в сторону соседнего помещения. Реверс удобен там, где нежелательно, чтобы полотно занимало пространство в комнате.' },
  { q: 'Как определить сторонность — левая дверь или правая?',
    a: 'Встаньте лицом к двери снаружи помещения (со стороны, где открываете). Если петли справа — дверь правая, петли слева — левая. Правило одинаково для «Секрет» и «Секрет Реверс». Замерщик ВФД уточнит сторонность при выезде.' },
  { q: 'Какой цвет алюминиевой кромки выбрать?',
    a: 'Три варианта: чёрная (анодированный алюминий) — под тёмную фурнитуру и контрастный интерьер; серебро (натуральный алюминий) — нейтральный, для светлых стен; золото (золотистый анод) — под бронзу, латунь и арт-деко. Цена одинакова для всех трёх.' },
  { q: 'Какой нужен проём?',
    a: 'Проём должен быть ровным, откосы — вровень с плоскостью стены. Минимальная толщина стены — 90 мм. Замерщик выезжает бесплатно и даёт конкретные рекомендации.' },
  { q: 'Есть нестандартные размеры?',
    a: `Стандарт в наличии: ширины ${SECRET_SIZES.join(', ')} мм, высота 2000 мм. Нестандартные высоты под заказ — от 2050 до 2700 мм, надбавка к цене полотна от +20% до +50%. Срок изготовления: ${CUSTOM_LEAD_TIME}.` },
  { q: 'Сколько стоит установка?',
    a: 'Стоимость монтажа рассчитывается отдельно. Мы работаем по Челябинску, даём гарантию на работы. Уточняйте у менеджера при заказе.' },
]

const structuredData = canonicalUrl ? [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.label,
      ...(item.href ? { item: new URL(item.href, canonicalUrl).href } : {}),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  ...(featuredWorks.length > 0 ? [{
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Наши работы — монтаж скрытых дверей в Челябинске и Челябинской области',
    itemListElement: featuredWorks.map((w, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'CreativeWork',
        name: w.title,
        ...(w.story ? { description: w.story } : {}),
        dateCreated: w.date,
        image: w.images,
        ...(w.location ? { locationCreated: { '@type': 'Place', name: w.location } } : {}),
      },
    })),
  }] : []),
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Скрытые двери — серии «Секрет» и «Секрет Реверс»',
    description: 'Двери скрытого монтажа: полотно заподлицо со стеной, алюминиевый короб, скрытые петли. Под покраску, штукатурку, обои. Кромка: чёрная, серебро, золото.',
    brand: { '@type': 'Brand', name: 'ВФД' },
    image: IMAGES.invisible,
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'RUB',
      lowPrice: TOTAL_SECRET,
      highPrice: TOTAL_SECRET_REVERS,
      availability: 'https://schema.org/InStock',
      areaServed: [
        { '@type': 'City', name: 'Челябинск' },
        { '@type': 'AdministrativeArea', name: 'Челябинская область' },
      ],
    },
  },
] : undefined
---

<BaseLayout
  title="Скрытые двери в Челябинске — «Секрет» и «Секрет Реверс», цены | ВФД"
  description={`Скрытые двери в Челябинске: серии «Секрет» (прямой монтаж) и «Секрет Реверс». Полотно вровень со стеной, без наличников, скрытые петли. Кромка: чёрная, серебро, золото. Комплект от ${fmt(TOTAL_SECRET)}. Замер бесплатно, монтаж под ключ.`}
  ogImage={IMAGES.invisible}
  preloadImage={IMAGES.covers[0].src}
  canonical={canonicalUrl}
  structuredData={structuredData}
>

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════ -->
  <div class="container sd-hero-wrap">
    <section class="sd-hero" aria-label="Двери скрытого монтажа">
      <CoverSwitcher client:load />

      <div class="sd-hero__body">
        <p class="sd-eyebrow">Скрытый монтаж · Челябинск</p>
        <h1 class="sd-hero__h1">Двери скрытого<br/>монтажа</h1>
        <p class="sd-hero__lead">
          Полотно вровень со стеной. Без наличников,
          без видимых петель. Алюминиевый короб прячется
          в проём — снаружи только чистая плоскость.
        </p>
        <div class="sd-hero__actions">
          <a href={TG} target="_blank" rel="noopener" class="btn btn-ghost">Получить расчёт</a>
          <a href={`tel:${PHONE}`} class="btn btn-ghost">Позвонить</a>
        </div>
      </div>
    </section>
  </div>

  <!-- ══════════════════════════════════════════════
       СЕРИИ — 2 ПРОДУКТА
  ══════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="sd-products">

        <!-- Секрет -->
        <article class="sd-product">
          <div class="sd-product__photo">
            <img
              src={IMAGES.invisible}
              alt="Скрытая дверь серии «Секрет» — прямой монтаж"
              loading="lazy"
              decoding="async"
              width="800"
              height="1000"
            />
          </div>
          <div class="sd-product__info">
            <span class="sd-product__eyebrow">Серия</span>
            <h2 class="sd-product__name">«Секрет»</h2>
            <p class="sd-product__type">Прямой монтаж</p>
            <p class="sd-product__desc">
              Классический скрытый монтаж: дверь открывается «на себя».
              Алюминиевый короб монтируется заподлицо, полотно в грунте —
              под покраску, штукатурку или оклейку обоями в цвет стен.
            </p>
            <div class="sd-product__specs">
              <div class="sd-spec">
                <span class="sd-spec__key">Ширины в наличии</span>
                <span class="sd-spec__val">{SECRET_SIZES.map(w => `${w} мм`).join(' · ')}</span>
              </div>
              <div class="sd-spec">
                <span class="sd-spec__key">Высота стандарт</span>
                <span class="sd-spec__val">{DOOR_HEIGHT} мм</span>
              </div>
              <div class="sd-spec">
                <span class="sd-spec__key">Направление</span>
                <span class="sd-spec__val">Левая · Правая</span>
              </div>
              <div class="sd-spec">
                <span class="sd-spec__key">Цвет кромки</span>
                <span class="sd-spec__val">Чёрная · Серебро · Золото</span>
              </div>
            </div>
            <div class="sd-product__price">
              <div>
                <span class="sd-price-label">Полотно</span>
                <span class="sd-price-val">{fmt(POLOTNO_PRICE_SECRET)}</span>
              </div>
              <div>
                <span class="sd-price-label">Комплект с коробом</span>
                <span class="sd-price-val sd-price-val--accent">от {fmt(TOTAL_SECRET)}</span>
              </div>
            </div>
            <a href={TG} target="_blank" rel="noopener" class="btn btn-primary sd-product__btn">
              Рассчитать стоимость
            </a>
          </div>
        </article>

        <!-- Секрет Реверс -->
        <article class="sd-product sd-product--rev">
          <div class="sd-product__photo">
            <img
              src={IMAGES.invisibleRev}
              alt="Скрытая дверь серии «Секрет Реверс» — реверсивный монтаж"
              loading="lazy"
              decoding="async"
              width="800"
              height="1000"
            />
          </div>
          <div class="sd-product__info">
            <span class="sd-product__eyebrow">Серия</span>
            <h2 class="sd-product__name">«Секрет Реверс»</h2>
            <p class="sd-product__type">Реверсивный монтаж</p>
            <p class="sd-product__desc">
              Дверь открывается «от себя» — в сторону соседнего помещения.
              Удобно, когда нежелательно, чтобы полотно занимало пространство
              в текущей комнате. При заказе указывается сторона петель.
            </p>
            <div class="sd-product__specs">
              <div class="sd-spec">
                <span class="sd-spec__key">Ширины в наличии</span>
                <span class="sd-spec__val">{SECRET_REVERS_SIZES.map(w => `${w} мм`).join(' · ')}</span>
              </div>
              <div class="sd-spec">
                <span class="sd-spec__key">Высота стандарт</span>
                <span class="sd-spec__val">{DOOR_HEIGHT} мм</span>
              </div>
              <div class="sd-spec">
                <span class="sd-spec__key">Направление</span>
                <span class="sd-spec__val">Левая · Правая</span>
              </div>
              <div class="sd-spec">
                <span class="sd-spec__key">Цвет кромки</span>
                <span class="sd-spec__val">Чёрная · Серебро · Золото</span>
              </div>
            </div>
            <div class="sd-product__price">
              <div>
                <span class="sd-price-label">Полотно</span>
                <span class="sd-price-val">{fmt(POLOTNO_PRICE_SECRET_REVERS)}</span>
              </div>
              <div>
                <span class="sd-price-label">Комплект с коробом</span>
                <span class="sd-price-val sd-price-val--accent">от {fmt(TOTAL_SECRET_REVERS)}</span>
              </div>
            </div>
            <a href={TG} target="_blank" rel="noopener" class="btn btn-primary sd-product__btn">
              Рассчитать стоимость
            </a>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       ТАБЛИЦА ЦЕН И РАЗМЕРОВ
  ══════════════════════════════════════════════ -->
  <section class="section" style="padding-top: 0">
    <div class="container">
      <h2 class="sd-h2">Цены и размеры</h2>

      <div class="sd-table-wrap">
        <table class="sd-compare">
          <thead>
            <tr>
              <th scope="col" class="sd-compare__row-head"></th>
              <th scope="col">«Секрет»</th>
              <th scope="col">«Секрет Реверс»</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Монтаж</th>
              <td>Прямой</td>
              <td>Реверсивный</td>
            </tr>
            <tr>
              <th scope="row">Ширины в наличии</th>
              <td>{SECRET_SIZES.map(w => `${w}`).join(', ')} мм</td>
              <td>{SECRET_REVERS_SIZES.map(w => `${w}`).join(', ')} мм</td>
            </tr>
            <tr>
              <th scope="row">Высота (стандарт)</th>
              <td colspan="2" class="sd-compare__shared">{DOOR_HEIGHT} мм</td>
            </tr>
            <tr>
              <th scope="row">Направление петель</th>
              <td>Левая / Правая</td>
              <td>Левая / Правая</td>
            </tr>
            <tr>
              <th scope="row">Цвет кромки</th>
              <td colspan="2" class="sd-compare__shared">Чёрная / Серебро / Золото</td>
            </tr>
            <tr class="sd-compare__price-row">
              <th scope="row">Полотно</th>
              <td>{fmt(POLOTNO_PRICE_SECRET)}</td>
              <td>{fmt(POLOTNO_PRICE_SECRET_REVERS)}</td>
            </tr>
            <tr class="sd-compare__price-row sd-compare__kit-row">
              <th scope="row">Комплект с коробом</th>
              <td><strong>{fmt(TOTAL_SECRET)}</strong></td>
              <td><strong>{fmt(TOTAL_SECRET_REVERS)}</strong></td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="sd-table-foot">
        В комплект входит: короб 54×43×2200 мм, ответная планка, 2 скрытые петли.
        Ручка, стопор и завёртка WC — опционально.
      </p>

      <!-- Инфо-изображения: комплектация + сторонность -->
      <InfoImageViewer
        client:load
        images={[
          { src: INFO_IMAGES.kompl, caption: 'Состав комплекта', alt: 'Состав комплекта скрытой двери — профиль, петли, ответная планка' },
          { src: INFO_IMAGES.lr,    caption: 'Схема сторонности', alt: 'Схема сторонности (левая / правая) открывания скрытой двери' },
        ]}
      />

      <!-- Нестандартные высоты -->
      <div class="sd-custom-section">
        <h3 class="sd-h3">Нестандартные высоты — под заказ</h3>
        <p class="sd-p" style="margin-bottom: 1rem">
          Надбавка применяется к полотну и коробу. Максимальная высота — 2700 мм.
          Срок изготовления: {CUSTOM_LEAD_TIME}.
        </p>
        <div class="sd-table-wrap">
          <table class="sd-compare">
            <thead>
              <tr>
                <th scope="col">Высота</th>
                <th scope="col">Надбавка</th>
                <th scope="col">«Секрет», комплект</th>
                <th scope="col">«Секрет Реверс», комплект</th>
              </tr>
            </thead>
            <tbody>
              {CUSTOM_HEIGHT_TIERS.map(tier => (
                <tr>
                  <th scope="row">{tier.range} мм</th>
                  <td class="sd-custom__pct">{tier.pct}</td>
                  <td>{fmt(calcCustomPrice(TOTAL_SECRET, tier.surcharge))}</td>
                  <td>{fmt(calcCustomPrice(TOTAL_SECRET_REVERS, tier.surcharge))}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="sd-table-foot" style="margin-top: 0.75rem">
          Цена включает полотно и короб с той же надбавкой. Ручка, стопор, завёртка WC — по стандартной цене.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       ЦВЕТ КРОМКИ
  ══════════════════════════════════════════════ -->
  <section class="section sd-color-section">
    <div class="container">
      <div class="sd-color-wrap">
        <div class="sd-color-text">
          <h2 class="sd-h2">Цвет кромки</h2>
          <p class="sd-p">
            Кромка — алюминиевая полоска по краям проёма шириной 13 мм.
            Её видно только под углом. Цена одинакова — выбирайте
            под планируемую отделку стен и фурнитуру.
          </p>
          <p class="sd-p">
            <strong>Чёрная кромка</strong> — анодированный алюминий.
            Подходит к тёмной фурнитуре и контрастным интерьерам.
          </p>
          <p class="sd-p">
            <strong>Серебро</strong> — натуральный алюминий.
            Нейтральный вариант для светлых стен и минимализма.
          </p>
          <p class="sd-p">
            <strong>Золото</strong> — анодированный алюминий золотистого оттенка.
            Подходит к интерьерам с бронзовой или латунной фурнитурой, стилю арт-деко.
          </p>
        </div>
        <div class="sd-color-selector">
          <ColorSelector client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       О КОНСТРУКЦИИ
  ══════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="sd-about">
        <div class="sd-about__text">
          <h2 class="sd-h2">О конструкции</h2>
          <p class="sd-p">
            Скрытые двери — конструкция, в которой алюминиевая коробка
            монтируется внутрь стены заподлицо с её поверхностью. Полотно
            навешивается на скрытые петли и устанавливается вровень со стеной.
            Снаружи — только тонкая кромка профиля.
          </p>
          <p class="sd-p">
            Алюминиевый профиль 54×43 мм — прочный и лёгкий. Выдерживает
            нагрузку до 70 кг. Минимальная толщина стены — 90 мм.
            Зазор между полотном и стеной — 1–2 мм.
          </p>
          <p class="sd-p">
            В ВФД скрытые двери поставляются напрямую с фабрики: замер
            по Челябинску, проект, доставка и монтаж бригадой с гарантией.
          </p>
          <div class="sd-about__actions">
            <a href={TG} target="_blank" rel="noopener" class="btn btn-primary">Написать в Telegram</a>
            <a href="/contacts" class="btn btn-outline">Контакты</a>
          </div>
        </div>
        <div class="sd-about__photo sd-about__photo--info">
          <img
            src={INFO_IMAGES.constr}
            alt="Конструкция скрытой двери — схема узлов монтажа"
            loading="lazy"
            decoding="async"
            width="1200"
            height="900"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       НАШИ РАБОТЫ
  ══════════════════════════════════════════════ -->
  {INVISIBLE_WORKS.length > 0 && (
    <section class="section" id="nashi-raboty" aria-labelledby="works-heading">
      <div class="container">
        <h2 class="sd-h2" id="works-heading">Наши работы</h2>
        <p class="sd-p" style="margin-top: -0.75rem; margin-bottom: 1.75rem">
          Реальные объекты нашей бригады в Челябинске и Челябинской области — с фото монтажа и полной спецификацией каждой двери.
        </p>
        <WorksGallery client:load works={INVISIBLE_WORKS} tgHref={TG} limit={WORKS_LIMIT} archiveHref={ARCHIVE_HREF} />
      </div>
    </section>
  )}

  <!-- ══════════════════════════════════════════════
       FAQ
  ══════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <h2 class="sd-h2">Частые вопросы</h2>
      <div class="sd-faq">
        {faq.map(f => (
          <details class="sd-faq__item">
