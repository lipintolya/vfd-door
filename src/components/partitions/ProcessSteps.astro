---
import type { Step } from '../../data/partitions'

interface Props { items: Step[] }
const { items } = Astro.props
---

<ol class="ps" role="list">
  {items.map((s, i) => (
    <li class="ps-card" style={`--stagger:${i * 90}ms`}>
      <span class="ps-bg-num" aria-hidden="true">{s.num}</span>
      <div class="ps-head">
        <span class="ps-badge" aria-hidden="true">{s.num}</span>
        <h3 class="ps-title">{s.title}</h3>
      </div>
      <p class="ps-text">{s.text}</p>
      <ul class="ps-list" role="list">
        {s.details.map(d => (
          <li class="ps-item">
            <svg class="ps-check" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.4"/>
              <path d="M5 8.2l2 2 4-4.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {d}
          </li>
        ))}
      </ul>
    </li>
  ))}
</ol>

<style>
  .ps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1rem, 2vw, 1.375rem);
  }

  .ps-card {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    border-radius: 1.5rem;
    border: 1px solid #e2e8f0;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: box-shadow 300ms ease, transform 300ms ease, border-color 300ms ease;
  }
  .ps-card:hover {
    border-color: #99f6e4;
    box-shadow: 0 8px 28px rgba(13, 148, 136, 0.10);
    transform: translateY(-3px);
  }

  /* Призрачный номер на фоне */
  .ps-bg-num {
    position: absolute;
    top: -0.5rem;
    right: 0.875rem;
    font-size: clamp(5rem, 9vw, 8rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    color: color-mix(in srgb, #14b8a6 7%, transparent);
    user-select: none;
    pointer-events: none;
  }

  .ps-head {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    position: relative;
  }

  .ps-badge {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    background: #f0fdfa;
    border: 1.5px solid #99f6e4;
    display: grid;
    place-items: center;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #0d9488;
    font-variant-numeric: tabular-nums;
    transition: background 250ms ease, border-color 250ms ease;
  }
  .ps-card:hover .ps-badge {
    background: #14b8a6;
    border-color: #14b8a6;
    color: #fff;
  }

  .ps-title {
    margin: 0;
    padding-top: 0.3rem;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.25;
  }

  .ps-text {
    margin: 0;
    font-size: clamp(0.875rem, 1.15vw, 0.9375rem);
    color: #475569;
    line-height: 1.7;
  }

  .ps-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.875rem;
    border-top: 1px solid #f1f5f9;
  }

  .ps-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: #334155;
    line-height: 1.5;
  }

  .ps-check {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    margin-top: 0.15rem;
    color: #0d9488;
  }

  @media (max-width: 640px) {
    .ps { grid-template-columns: 1fr; }
    .ps-card { gap: 0.875rem; }
  }

  /* ── Scroll-reveal ── */
  .ps.js-reveal .ps-card {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity  550ms ease var(--stagger, 0ms),
      transform 550ms cubic-bezier(0.4, 0, 0.2, 1) var(--stagger, 0ms),
      box-shadow 300ms ease,
      border-color 300ms ease;
    will-change: opacity, transform;
  }
  .ps.js-reveal .ps-card.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ps.js-reveal .ps-card { opacity: 1; transform: none; transition: none; }
    .ps-card { transition: none; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  document.querySelectorAll('.ps').forEach((wrap) => {
    if (reduce || !('IntersectionObserver' in window)) return
    wrap.classList.add('js-reveal')
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible')
            io.unobserve(e.target)
          }
        })
      },
      { threshold: 0.1, rootMargin: '0px 0px -5% 0px' },
    )
    wrap.querySelectorAll('.ps-card').forEach((c) => io.observe(c))
  })
</script>
