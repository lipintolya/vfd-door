---
const items = [
  { id: 'pt-profiles', label: 'Профили' },
  { id: 'pt-colors',   label: 'Цвета' },
  { id: 'pt-glass',    label: 'Остекление' },
  { id: 'pt-benefits', label: 'Преимущества' },
  { id: 'pt-process',  label: 'Процесс' },
  { id: 'pt-projects', label: 'Проекты' },
]
---

<nav
  id="pt-snav"
  class="pt-snav"
  aria-label="Разделы страницы"
  aria-hidden="true"
>
  <div class="container">
    <div class="pt-snav__pill">
      <ul class="pt-snav__list" role="list">
        {items.map(it => (
          <li>
            <a href={`#${it.id}`} class="pt-snav__link" data-snav={it.id}>
              {it.label}
            </a>
          </li>
        ))}
      </ul>
      <button
        id="pt-snav-close"
        class="pt-snav__close"
        type="button"
        aria-label="Скрыть навигационное меню"
        title="Скрыть навигационное меню"
      >
        <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
</nav>

<style>
  .pt-snav {
    position: fixed;
    top: var(--header-height, 88px);
    left: 0;
    right: 0;
    z-index: 45;
    padding: 0.5rem 0;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity 220ms ease, transform 220ms ease;
  }
  .pt-snav.pt-snav--visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  /* Пилюля — повторяет стиль хедера */
  .pt-snav__pill {
    border-radius: 9999px;
    border: 1px solid rgba(226, 232, 240, 0.9);
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
    padding: 0.3rem 0.5rem;
    overflow: hidden;
  }

  .pt-snav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.125rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .pt-snav__list::-webkit-scrollbar { display: none; }

  .pt-snav__link {
    display: inline-block;
    padding: 0.3rem 0.875rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #64748b;
    text-decoration: none;
    white-space: nowrap;
    transition: background 150ms ease, color 150ms ease;
  }
  .pt-snav__link:hover { background: #f0fdfa; color: #0d9488; }
  .pt-snav__link.pt-snav--active {
    background: #0d9488;
    color: #fff;
  }

  /* Пилюля: flex чтобы кнопка закрытия прижималась вправо */
  .pt-snav__pill {
    display: flex;
    align-items: center;
  }
  .pt-snav__list { flex: 1; min-width: 0; }

  .pt-snav__close {
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: #94a3b8;
    display: grid;
    place-items: center;
    cursor: pointer;
    margin-left: 0.25rem;
    transition: background 150ms ease, color 150ms ease;
  }
  .pt-snav__close svg { width: 0.75rem; height: 0.75rem; }
  .pt-snav__close:hover {
    background: #fee2e2;
    color: #ef4444;
  }
</style>

<script>
  ;(function () {
    const nav = document.getElementById('pt-snav')
    if (!(nav instanceof HTMLElement)) return

    let dismissed = sessionStorage.getItem('pt-snav-dismissed') === '1'

    const onScroll = () => {
      if (dismissed) return
      const show = window.scrollY > 380
      nav.classList.toggle('pt-snav--visible', show)
      nav.setAttribute('aria-hidden', show ? 'false' : 'true')
    }
    window.addEventListener('scroll', onScroll, { passive: true })

    const closeBtn = document.getElementById('pt-snav-close')
    if (closeBtn instanceof HTMLElement) {
      closeBtn.addEventListener('click', () => {
        dismissed = true
        sessionStorage.setItem('pt-snav-dismissed', '1')
        nav.classList.remove('pt-snav--visible')
        nav.setAttribute('aria-hidden', 'true')
      })
    }

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-snav]'))
    const ids = ['pt-profiles', 'pt-colors', 'pt-glass', 'pt-benefits', 'pt-process', 'pt-projects']

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return
            links.forEach((l) => {
              l.classList.toggle('pt-snav--active', l.dataset.snav === e.target.id)
            })
            nav.querySelector('.pt-snav--active')?.scrollIntoView({ inline: 'nearest', block: 'nearest' })
          })
        },
        { rootMargin: '-15% 0px -75% 0px' },
      )
      ids.forEach((id) => {
        const el = document.getElementById(id)
        if (el) io.observe(el)
      })
    }

    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault()
        const target = document.getElementById(link.dataset.snav ?? '')
        if (!target) return
        const offset =
          (parseInt(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 88) + 48
        window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - offset, behavior: 'smooth' })
      })
    })
  })()
</script>
