---
---
<div id="ann-bar" class="ann-bar">
  <div class="container">
    <div class="ann-bar__inner">

      <svg class="ann-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"/>
        <path d="M12 8v4m0 4h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>

      <p class="ann-bar__text">
        Сайт в процессе наполнения — часть разделов пока дополняется. Приносим извинения за временные неудобства.
        По вопросам и предложениям&nbsp;—
        <a href="https://t.me/tolyalipin" target="_blank" rel="noopener" class="ann-bar__link">написать в Telegram</a>.
      </p>

      <button id="ann-close" class="ann-bar__close" type="button" aria-label="Закрыть">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>

    </div>
  </div>
</div>

<script is:inline>
(function () {
  var bar = document.getElementById('ann-bar')
  if (!bar) return
  if (localStorage.getItem('ann-dismissed') === '1') {
    bar.style.display = 'none'
    return
  }
  document.getElementById('ann-close').addEventListener('click', function () {
    localStorage.setItem('ann-dismissed', '1')
    bar.style.maxHeight = bar.scrollHeight + 'px'
    bar.style.overflow  = 'hidden'
    bar.style.transition = 'max-height 350ms ease, opacity 280ms ease'
    requestAnimationFrame(function () {
      bar.style.maxHeight = '0'
      bar.style.opacity   = '0'
    })
    setTimeout(function () { bar.style.display = 'none' }, 380)
  })
})()
</script>

<style>
.ann-bar {
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
  padding: 0.5rem 0;
}

.ann-bar__inner {
  display: flex;
  align-items: center;
  gap: 0.625rem;
}

.ann-bar__icon {
  flex-shrink: 0;
  color: #14b8a6;
}

.ann-bar__text {
  flex: 1;
  margin: 0;
  font-size: 0.8rem;
  line-height: 1.45;
  color: #475569;
}

.ann-bar__link {
  color: #0d9488;
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
}
.ann-bar__link:hover {
  text-decoration: underline;
}

.ann-bar__close {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1.75rem;
  height: 1.75rem;
  border: none;
  background: transparent;
  color: #94a3b8;
  cursor: pointer;
  border-radius: 6px;
  transition: color 150ms ease, background 150ms ease;
}

.ann-bar__close:hover {
  color: #475569;
  background: #e2e8f0;
}

@media (max-width: 480px) {
  .ann-bar__text {
    font-size: 0.75rem;
  }
}
</style>
