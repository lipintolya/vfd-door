---
import FigureLightbox from './FigureLightbox.vue'

interface Props {
  src: string
  alt?: string
  caption?: string
  /** @deprecated фото больше не выходит за пределы колонки текста — проп оставлен,
      чтобы не трогать существующий контент статей, но ни на что не влияет. */
  wide?: boolean
}

const { src, alt = '', caption } = Astro.props
---

<figure class="article-figure">
  <FigureLightbox src={src} alt={alt} client:visible />
  {caption && (
    <figcaption class="mt-2 text-center text-sm text-slate-400">
      {caption}
    </figcaption>
  )}
</figure>

<style>
.article-figure {
  margin: 2rem 0;
}
</style>
