---
/**
 * src/components/home/PriceIncreaseNotice.astro
 * Баннер о повышении цен с 03.08.2026 — между hero и Features на главной.
 * Виден только до даты повышения (включительно 2 августа) — после сборки,
 * запущенной 3 августа или позже, блок перестаёт рендериться сам собой.
 * Разовый маркетинговый баннер, не превращаем в общую систему промо-баннеров
 * ради одного использования.
 */
import { companyLegalInfo } from '../../lib/contacts-data'

const PRICE_INCREASE_DATE = new Date('2026-08-03T00:00:00+05:00')
const show = new Date() < PRICE_INCREASE_DATE

const PHONE = companyLegalInfo.contacts.phone[0]!.raw
const PHONE_LABEL = companyLegalInfo.contacts.phone[0]!.label
const TG = 'https://t.me/vfddoors74'
const IMAGE = 'https://storage.yandexcloud.net/vfd74ru/Main_page/info_hero/high_price_info.webp'

const increases = [
  { percent: '7%', series: 'Атум и Атум Про' },
  { percent: '5%', series: 'Эмалекс, Эмалекс Модерн, Элегант, Иннова, Некст, Лайт' },
  { percent: '5%', series: 'щитовые двери — Урбан, Бейсик, Смарт, Соло, Авант, Антик, Классик Арт' },
  { percent: '5%', series: 'двери в эмали — Линия, Антик Люкс, Премиум, Стокгольм, Винтер, Скинель, Классик Люкс' },
]
---

{show && (
  <section class="section pin-section">
    <div class="container">
      <div class="pin-card">
        <div class="pin-card__media">
          <img
            src={IMAGE}
            alt="Повышение цен на двери ВФД с 3 августа 2026 года"
            loading="lazy"
            decoding="async"
            width="700"
            height="700"
          />
        </div>
        <div class="pin-card__body">
          <p class="pin-eyebrow">⚠️ Важно</p>
          <h2 class="pin-h2">С 3 августа — повышение цен на межкомнатные двери</h2>
          <p class="pin-p">
            Уважаемые покупатели! Информируем, что с 03.08.2026 фабрика-производитель
            «Владимирская фабрика дверей» повышает отпускные цены на часть ассортимента.
          </p>
          <p class="pin-p pin-p--tight">Повышение связано с увеличением стоимости материалов и составит:</p>
          <ul class="pin-list">
            {increases.map(row => (
              <li class="pin-list__item">
                <span class="pin-list__percent">{row.percent}</span>
                <span>{row.series}</span>
              </li>
            ))}
          </ul>
          <p class="pin-p">
            📅 До 2 августа включительно у вас есть возможность оформить заказ по действующим ценам.
          </p>
          <p class="pin-p">
            Если вы уже планировали замену дверей или находитесь на этапе ремонта — сейчас
            самое выгодное время для покупки. Это позволит зафиксировать текущую стоимость
            и избежать дополнительных расходов после повышения.
          </p>
          <p class="pin-p pin-p--tight">
            📞 Обращайтесь к нашим менеджерам — поможем подобрать модель, рассчитаем
            стоимость и оформим заказ до изменения цен.
          </p>
          <div class="pin-actions">
            <a href={TG} target="_blank" rel="noopener" class="btn btn-outline">Написать в Telegram</a>
            <a href={`tel:${PHONE}`} class="btn btn-outline">{PHONE_LABEL}</a>
          </div>
          <p class="pin-closing">Не откладывайте покупку — с 3 августа двери будут стоить дороже.</p>
        </div>
      </div>
    </div>
  </section>
)}

<style>
.pin-section { padding-top: 0; }
.pin-card {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
  overflow: hidden;
  border-radius: 1.5rem;
  border: 1px solid #fde68a;
  background: #fffbeb;
}
/* Это не фото, а плакат с текстом внутри (заголовок, даты, бейдж) —
   object-fit:cover его обрежет и утащит часть текста за край. Только
   contain: картинка целиком, без потерь, на любой ширине контейнера. */
.pin-card__media {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  padding: 1rem;
}
.pin-card__media img {
  display: block;
  width: 100%;
  height: 100%;
  max-height: 26rem;
  aspect-ratio: 1/1;
  object-fit: contain;
}
.pin-card__body { padding: clamp(1.75rem, 4vw, 3rem); }

.pin-eyebrow {
  margin: 0 0 0.75rem;
  font-size: 0.8125rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #b45309;
}
.pin-h2 {
  margin: 0 0 1.125rem;
  font-size: clamp(1.5rem, 2.6vw, 2rem);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: -0.02em;
  color: #0f172a;
}
.pin-p {
  margin: 0 0 1rem;
  font-size: 0.9375rem;
  line-height: 1.7;
  color: #334155;
}
.pin-p--tight { margin-bottom: 0.75rem; font-weight: 600; color: #1e293b; }

.pin-list {
  margin: 0 0 1.25rem;
  padding: 0;
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
}
.pin-list__item {
  display: flex;
  align-items: baseline;
  gap: 0.625rem;
  font-size: 0.875rem;
  line-height: 1.55;
  color: #334155;
}
.pin-list__percent {
  flex-shrink: 0;
  min-width: 2.75rem;
  font-weight: 700;
  color: #b45309;
}

.pin-actions { display: flex; flex-wrap: wrap; gap: 0.625rem; margin-bottom: 1.5rem; }
.pin-actions .btn-outline { border-color: #d97706; color: #92400e; }
.pin-actions .btn-outline:hover { border-color: #92400e; color: #78350f; }

.pin-closing {
  margin: 0;
  padding-top: 1.25rem;
  border-top: 1px solid #fde68a;
  font-size: 0.9375rem;
  font-weight: 700;
  color: #92400e;
}

@media (min-width: 900px) {
  .pin-card { grid-template-columns: 0.85fr 1.15fr; align-items: stretch; }
  .pin-card__media img { max-height: none; }
}
</style>
