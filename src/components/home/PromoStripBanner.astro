---
/**
 * src/components/home/PromoStripBanner.astro
 *
 * Плашка-анонс акций между хиро и остальным контентом главной. Ведёт к
 * блоку #promo (Promo.vue). Статика без JS — переход по обычному якорю
 * <a href="#promo">, без анимаций при монтировании (не нагружаем страницу).
 */

const IMAGE = 'https://storage.yandexcloud.net/vfd74ru/promo_main/F3563280-790C-49CB-A81E-00ED9A0D2A3B.webp'
---

<div class="pt-6 sm:pt-8">
  <div class="container">
    <a href="#promo" class="promo-strip group">
      <div class="promo-strip__image-wrap">
        <img
          src={IMAGE}
          alt="Акции и спецпредложения ВФД"
          loading="lazy"
          decoding="async"
          width="1200"
          height="400"
          class="promo-strip__image"
        />
      </div>
      <div class="promo-strip__panel">
        <div class="promo-strip__text">
          <h2 class="promo-strip__title">Акции</h2>
          <p class="promo-strip__subtitle">Скидки на популярные модели дверей — успейте до конца месяца</p>
        </div>
        <span class="btn btn-ghost promo-strip__btn" aria-hidden="true">
          Смотреть акции
          <svg class="btn-arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </div>
    </a>
  </div>
</div>

<style>
  .promo-strip {
    display: block;
    overflow: hidden;
    border-radius: 1.5rem;
    background: #18181b;
    text-decoration: none;
  }

  .promo-strip__image-wrap {
    overflow: hidden;
    height: clamp(7.2rem, 17.6vw, 12.8rem);
  }

  .promo-strip__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .promo-strip:hover .promo-strip__image {
    transform: scale(1.04);
  }

  .promo-strip__panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: clamp(1rem, 2.4vw, 1.6rem) clamp(1.25rem, 4vw, 2.5rem);
  }

  .promo-strip__title {
    margin: 0 0 0.375rem;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: #fff;
  }

  .promo-strip__subtitle {
    margin: 0;
    max-width: 30rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.6);
  }

  .promo-strip__btn {
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .promo-strip__panel {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
