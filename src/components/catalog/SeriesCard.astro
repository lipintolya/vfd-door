---
/**
 * src/components/catalog/SeriesCard.astro
 * Бенто-плитка серии для превью на /catalog — фото на всю карточку,
 * градиент, текст поверх (тот же язык, что у бенто-карточек каталога
 * на главной, см. CatalogCategories.vue). Ширину/сетку задаёт родитель.
 */
interface Props {
  series: {
    slug:       string
    name:       string
    tagline:    string
    cover:      string
    minPrice:   number | null
    modelCount: number
  }
}

const { series: s } = Astro.props
const fmt = (n: number) => n.toLocaleString('ru-RU') + ' ₽'
---

<a
  href={`/catalog/series/${s.slug}`}
  class="group relative flex aspect-4/5 flex-col justify-end overflow-hidden rounded-2xl bg-slate-100"
>
  {s.cover && (
    <img
      src={s.cover}
      alt={`Серия ${s.name} — ВФД`}
      loading="lazy"
      decoding="async"
      width="300"
      height="375"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
    />
  )}
  <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/5 to-transparent" aria-hidden="true"></div>
  <div class="relative z-10 flex flex-col gap-1.5 p-4 sm:p-6">
    <span class="text-xl font-semibold text-white sm:text-2xl">{s.name}</span>
    {s.tagline && <span class="line-clamp-2 text-sm leading-snug text-white/80 sm:text-base">{s.tagline}</span>}
    <span class="mt-1 text-lg font-bold text-white sm:text-xl">
      {s.minPrice ? `от ${fmt(s.minPrice)}` : `${s.modelCount} ${s.modelCount === 1 ? 'модель' : 'моделей'}`}
    </span>
  </div>
</a>
