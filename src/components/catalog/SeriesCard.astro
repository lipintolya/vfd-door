---
/**
 * src/components/catalog/SeriesCard.astro
 * Карточка серии для превью-полос (сейчас — верх /catalog). Ширину/сетку
 * задаёт родитель, сама карточка — просто содержимое (фото+название+
 * тег-лайн+цена), чтобы её можно было переиспользовать в разных layout
 * (десктопная горизонтальная лента / мобильная сетка).
 */
interface Props {
  series: {
    slug:       string
    name:       string
    tagline:    string
    cover:      string
    minPrice:   number | null
    modelCount: number
  }
}

const { series: s } = Astro.props
const fmt = (n: number) => n.toLocaleString('ru-RU') + ' ₽'
---

<a href={`/catalog/series/${s.slug}`} class="group flex flex-col gap-2.5">
  <div class="aspect-3/4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-100">
    {s.cover && (
      <img
        src={s.cover}
        alt={`Серия ${s.name} — ВФД`}
        loading="lazy"
        decoding="async"
        width="300"
        height="400"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    )}
  </div>
  <div class="flex flex-col gap-1 px-0.5">
    <span class="text-sm font-semibold text-slate-900">{s.name}</span>
    {s.tagline && <span class="line-clamp-2 text-xs leading-snug text-slate-500">{s.tagline}</span>}
    <span class="mt-0.5 text-xs font-semibold text-teal-700">
      {s.minPrice ? `от ${fmt(s.minPrice)}` : `${s.modelCount} ${s.modelCount === 1 ? 'модель' : 'моделей'}`}
    </span>
  </div>
</a>
