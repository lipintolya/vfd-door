---
interface Props {
  id: string
  name: string
  series: string
  coating: string
  color: string
  colorHex: string
  photo: string
  price: number | null
  inStock: boolean
}

const { id, name, series, coating, color, colorHex, photo, price, inStock } = Astro.props
---

<a
  href={`/models/${id}`}
  class="group flex flex-col bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden h-full"
  aria-label={`${name} — подробнее`}
>
  <!-- Image: увеличенная высота -->
  <div class="relative w-full bg-gray-50 flex items-center justify-center p-4 shrink-0 h-64 sm:h-72">
    {photo ? (
      <img
        src={photo}
        alt={name}
        class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
        width="280"
        height="373"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-gray-200">
        <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <path d="M3 9h18M9 21V9"/>
        </svg>
      </div>
    )}
    
    <!-- Badges -->
    <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
      <span class="px-2 py-1 bg-zinc-900/90 backdrop-blur text-white text-[10px] font-bold rounded uppercase tracking-wide">
        {series}
      </span>
      {inStock && (
        <span class="px-2 py-1 bg-teal-600/90 backdrop-blur text-white text-[10px] font-bold rounded">
          В наличии
        </span>
      )}
    </div>
  </div>

  <!-- Content -->
  <div class="p-4 flex flex-col flex-1">
    <h3 class="font-semibold text-gray-900 text-base leading-snug mb-2 line-clamp-2 min-h-10">
      {name}
    </h3>
    
    <div class="flex items-center gap-2 mb-3">
      <span
        class="w-5 h-5 rounded-full border-2 border-gray-300 shadow-sm shrink-0"
        style={`background-color: ${colorHex}`}
        title={`Цвет: ${color}`}
      ></span>
      <span class="text-xs text-gray-600 font-medium">{color}</span>
    </div>
    
    <div class="mt-auto pt-3 border-t border-gray-100">
      <div class="flex items-baseline gap-1">
        <span class="text-teal-600 font-bold text-lg">
          {price ? `${Number(price).toLocaleString('ru-RU')} ₽` : 'По запросу'}
        </span>
        <span class="text-xs text-gray-400">за полотно</span>
      </div>
    </div>
  </div>
</a>